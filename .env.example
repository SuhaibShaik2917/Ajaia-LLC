# --- Database (Postgres / Supabase) -----------------------------------------
# Pooled connection (Supabase pooler, port 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) used by migrations / `prisma db push`
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Auth -------------------------------------------------------------------
# HS256 signing key for session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# --- Tests ------------------------------------------------------------------
# Dedicated, disposable database. NEVER point this at production.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/docket_test"
